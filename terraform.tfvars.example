subscription_id = "fcbf086b-8ce4-4ca5-a3d7-0c56489e25f6"

# Start with the shared infrastructure. Add real apps in subsequent applies.
app_images = {}

# Keep existing app entries when adding a service. The optional orders entry uses
# mb0101/ecommerce-store-invoice-api at the verified immutable digest in README
# section 8, with DocumentDB readiness and private Blob PDF storage support.
# Add payments using the verified mb0101/ecommerce-store-payments-api digest in
# README section 9. It reuses Mongo and requires the orders image to stay enabled.
# See docs/stripe-runtime.md before enabling Stripe test checkout.
# payments_stripe_enabled = true
# After deploying the VAT-capable Payments API and fulfillment job:
# payments_stripe_checkout_vat_enabled = true
# Supply Stripe credentials through TF_VAR_payments_stripe_secret_key and
# TF_VAR_payments_stripe_webhook_secret in your private deployment shell.
# See docs/payment-fulfillment.md before enabling the scheduled worker.
# payments_fulfillment_enabled = true
# Add livedocs using the verified mb0101/ecommerce-store-livedocs digest in README
# section 10. CI will use the private livedocs container; the host serves its image.

# Non-secret registry username. Provide its read-only token through
# TF_VAR_dockerhub_token in PowerShell; Terraform stores it as an ACA secret.
dockerhub_username = "mb0101"

# Keep this name to match existing Products photo URLs.
photo_storage_account_name = "stecproductsdevmb261013"

# Set passwords through TF_VAR_sql_admin_password / TF_VAR_mongo_admin_password.
# Never put them in this example or commit your local terraform.tfvars.


# Knowledge Assistant: first deploy the labelled demo without Search/model calls.
# knowledge_runtime_mode = "demo"
# Supply TF_VAR_knowledge_api_key and add both image digests to existing app_images.
# Keep any existing knowledge_search_enabled setting unless intentionally changing Search.
#
# For real LiveDocs: use knowledge_runtime_mode = "azure", then enable Free Search.
# knowledge_search_enabled = true
# knowledge_search_index = "knowledge-v1"
# knowledge_embedding_revision = "1"
# Model resources are configured separately; these reference existing deployments.
# knowledge_models = {
#   endpoint = "https://YOUR-RESOURCE.openai.azure.com/openai/v1/"
#   chat_deployment = "YOUR-CHAT-DEPLOYMENT"
#   embedding_deployment = "YOUR-EMBEDDING-DEPLOYMENT"
#   embedding_dimensions = 1536
# }
# Supply TF_VAR_knowledge_openai_api_key and TF_VAR_knowledge_api_key securely.
# Add verified images as knowledge_api / knowledge_web when ready. Keep every
# existing app_images entry. Azure mode needs the image with the indexed pinned
# corpus; demo mode can use the labelled baseline demo image.

# Pact registry: add app_images.pact using image-reference.json from the Pact CI run.
# pact = "docker.io/mb0101/ecommerce-store-pact-api@sha256:<64 hex digest>"
# Keep existing entries. Pact reuses the existing ACA environment/Mongo cluster.
# pact_publishers = {
#   payments-ci = ["payments"]
#   invoice-ci  = ["invoice"]
# }
# Supply matching token hashes through TF_VAR_pact_publisher_token_sha256 (JSON map).
# Keep the raw bearer tokens in their source repositories' PACT_PUBLISHER_TOKEN secrets.
# pact_mongo_database_name = "ecommerce-store-pact-db"
# pact_ingress_external = true # required for GitHub-hosted runners
# pact_allowed_ingress_cidrs = [] # optional stable IPv4 runner egress CIDRs

# Pact dashboard (WEB/11): retain pact and all existing entries in app_images, then add:
# pact_web = "docker.io/mb0101/ecommerce-store-pact-web@sha256:<64 hex digest>"
# Use image-reference.json from the frontend main CI's pact-web-image-reference artifact.
# Terraform sets PACT_API_URL to the same-environment Pact app name; no browser or
# frontend publisher credential is required. Runtime port/probes are 8080 and /health/*.
